{
  "name": "agentic-build",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic Build — a small full-stack app for tracking agent build pipelines.",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "typecheck": "npm run typecheck --workspace web",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "typescript-eslint": "^8.11.0"
  },
  "engines": {
    "node": ">=20"
  }
}
